# Copy to .env and adjust. The API refuses to start without DATABASE_URL.
DATABASE_URL=postgres://wit:wit@localhost:5432/wit_sprint_os?sslmode=disable

APP_ENV=development
PORT=8080

# Comma-separated list of allowed browser origins (the Next.js app).
CORS_ORIGINS=http://localhost:3000

READ_TIMEOUT=10s
WRITE_TIMEOUT=20s
SHUTDOWN_TIMEOUT=10s

# Registration needs a way to deliver the verification link. Outside production
# the token comes back in the response. In production it does not, so either a
# mailer must exist (none does yet) or this must be set — which writes the token
# to the log and makes the log a secret. Without either, sign-ups are refused.
VERIFICATION_TOKEN_IN_LOG=false
