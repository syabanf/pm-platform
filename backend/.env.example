# WIT Sprint OS — backend, run directly (not in Docker)
#
#   cp .env.example .env
#   make migrate-up && make run        -> http://localhost:8080
#
# Every variable is filled in with the same value the binary defaults to, so
# this file describes the running service rather than only part of it. Delete a
# line and the built-in default applies; the reasoning for each limit is in
# README.md#limits.
#
# Running the whole stack in Docker instead? Use ../.env.example — compose
# assembles DATABASE_URL for you and passes these through.
#
# This file is the template and is committed. Your copy — .env — is not.

# ================================================================= required ===
# The only variable with no default: the API refuses to start without it.
DATABASE_URL=postgres://wit:wit@localhost:5432/wit_sprint_os?sslmode=disable

# =================================================================== server ===
# development returns the e-mail verification token in the response so the
# sign-up flow can be completed without a mailer. See VERIFICATION_TOKEN_IN_LOG.
APP_ENV=development
PORT=8080

# Browser origins allowed to call the API. Comma-separated. The Next.js dev
# server is the default.
CORS_ORIGINS=http://localhost:3000

# ================================================================= timeouts ===
# REQUEST_TIMEOUT bounds one request end to end; STATEMENT_TIMEOUT bounds the
# query behind it and is what frees a connection when a client hangs up.
REQUEST_TIMEOUT=15s
STATEMENT_TIMEOUT=5s

# A whole-tenant DELETE cascades across eighteen foreign keys and is legitimately
# slow — measured at 41s for 302k tasks. At the ordinary request timeout a large
# tenant was permanently undeletable.
DELETE_TIMEOUT=120s

# How long any statement waits for a row lock. Set on the connection, so plain
# UPDATE and DELETE get it too, not only transactions.
LOCK_TIMEOUT=250ms

READ_TIMEOUT=10s
WRITE_TIMEOUT=20s
SHUTDOWN_TIMEOUT=10s

# ============================================================ database pool ===
# Per process: replicas x MAX_DB_CONNS must stay under the server's
# max_connections, or a replica fails to start. pgx would otherwise default to
# the CPU count, which silently becomes the real concurrency limit.
MAX_DB_CONNS=25
MIN_DB_CONNS=2

# Without these a pool grown during one burst keeps those connections for good.
# Idle connections are reaped on pgx's 60s health check, so allow for that.
MAX_CONN_IDLE_TIME=5m
MAX_CONN_LIFETIME=60m

# =================================================================== limits ===
# Decimal bytes, not MiB: 1M is 1,000,000.
MAX_BODY_SIZE=1M

# ============================================= registration / verification ===
# No mailer exists yet, so the verification token needs somewhere to go. Which
# mode is in force is printed at boot.
#
#   APP_ENV != production            -> token returned in the response
#   production + this set to true    -> token written to the log (log = secret)
#   production + this unset          -> sign-ups refuse with 503
#
# Irrelevant while APP_ENV=development, which is why it is left off here.
VERIFICATION_TOKEN_IN_LOG=false

# --- Sessions & rate limiting -------------------------------------------------
# How long a login lasts. Fixed, not sliding — using a session does not extend it.
SESSION_TTL=168h
# Per-IP ceiling across the whole API (requests per second, and burst).
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
# Separate, much tighter bucket for POST /auth/login: each failure teaches an
# attacker something, so five attempts a minute per IP is plenty for a person.
LOGIN_RATE_PER_MIN=5
