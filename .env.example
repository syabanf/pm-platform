# WIT Sprint OS — environment for the whole stack
#
#   cp .env.example .env
#   docker compose up -d          -> http://localhost:8081
#
# Every variable below is already filled in with a working value, so copying
# this file is enough to bring the stack up. Delete a line and the default in
# docker-compose.yml takes over; those defaults match
# backend/internal/config/config.go, so an unset variable behaves exactly as the
# binary would on its own.
#
# This file is the template and is committed. Your copy — .env — is not.
#
# Running the two halves outside Docker instead? The frontend needs nothing
# (npm run dev). The backend reads the same names from backend/.env; see
# backend/.env.example.

# ============================================================== the stack ===

# Host port the app is published on. The container always listens on 3000.
APP_PORT=8081

# Browser origins the API will accept. Must include wherever the app is served
# from, or every request from it fails CORS. Comma-separated.
CORS_ORIGINS=http://localhost:8081

# ============================================================== database ===

# Used to build the connection string and to initialise the Postgres container.
# Change the password before this leaves your machine — docker-compose.ghcr.yml
# refuses to start without one set explicitly, deliberately.
DB_USER=wit
DB_PASSWORD=wit
DB_NAME=wit_sprint_os

# There is no DATABASE_URL here on purpose: compose assembles it from the three
# above, so setting it would be ignored. Running the backend outside Docker is
# the case where you set it directly — that is backend/.env.

# ==================================================== registration e-mail ===

# There is no mailer yet, and the containerised backend runs APP_ENV=production,
# which means the verification token is NOT returned in the response. It has to
# go somewhere or POST /auth/register answers 503 and creates nothing.
#
#   true   -> the token is written to the backend log, so an operator can pass
#             the link on by hand. Treat the log as a secret.
#   unset  -> sign-ups refuse. Correct for a deployment that should not be
#             taking sign-ups until a mailer exists.
#
# Left on for the local stack so registration works out of the box.
VERIFICATION_TOKEN_IN_LOG=true

# Set to development to make the backend return the token in the response
# instead — convenient locally, never in a deployment.
# APP_ENV=production

# ====================================================== limits and timeouts ===
# All optional. Uncomment to override; the values shown are the defaults.
# Reasoning for each is in backend/README.md#limits.

# REQUEST_TIMEOUT=15s        # bounds one request end to end
# STATEMENT_TIMEOUT=5s       # bounds one query; survives a client hanging up
# DELETE_TIMEOUT=120s        # a whole-tenant cascade is legitimately slow
# LOCK_TIMEOUT=250ms         # one hot row must not park the pool
# READ_TIMEOUT=10s
# WRITE_TIMEOUT=20s
# SHUTDOWN_TIMEOUT=10s

# Per process. Replicas x MAX_DB_CONNS must stay under the server's
# max_connections, or a replica fails to start.
# MAX_DB_CONNS=25
# MIN_DB_CONNS=2
# MAX_CONN_IDLE_TIME=5m
# MAX_CONN_LIFETIME=60m

# Decimal bytes, not MiB: 1M is 1,000,000.
# MAX_BODY_SIZE=1M

# ======================================================= prebuilt images ===
# Only for docker-compose.ghcr.yml, which pulls instead of building.

# GHCR_IMAGE_PREFIX=ghcr.io/syabanf/pm-platform
# IMAGE_TAG=latest

# =========================================================== frontend only ===
# Where the app proxies /api/v1/* to. docker-compose.yml sets this as a build
# arg (http://backend:8080); only set it here if you run the frontend outside
# Docker against a backend somewhere else.

# BACKEND_URL=http://localhost:8080

# --- Sessions & rate limiting -------------------------------------------------
# How long a login lasts. Fixed, not sliding — using a session does not extend it.
SESSION_TTL=168h
# Per-IP ceiling across the whole API (requests per second, and burst).
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
# Separate, much tighter bucket for POST /auth/login: each failure teaches an
# attacker something, so five attempts a minute per IP is plenty for a person.
LOGIN_RATE_PER_MIN=5
